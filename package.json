{
  "name": "giro-certo-api",
  "version": "1.0.0",
  "description": "Back-end API para o ecossistema Giro Certo",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:setup": "node scripts/setup-db.js",
    "db:migrate": "node scripts/setup-db.js",
    "db:images": "node scripts/setup-images.js",
    "db:add-role": "node scripts/add-user-role.js",
    "create:admin": "node scripts/create-admin-user.js",
    "db:migrate:delivery-logistics": "node scripts/run-delivery-logistics-migration.js",
    "db:migrate:user-fcm-tokens": "node scripts/run-user-fcm-token-migration.js",
    "db:migrate:bike-garage-premium": "node scripts/run-bike-garage-premium-migration.js",
    "db:migrate:delivery-registration-schema": "node scripts/run-delivery-registration-schema-migrations.js",
    "db:wipe-delivery-orders": "node scripts/delete-all-delivery-orders.js",
    "db:migrate:delivery-payment": "node scripts/run-delivery-payment-migration.js",
    "db:migrate:delivery-settlement-ledger": "node scripts/run-delivery-settlement-ledger-migration.js",
    "db:migrate:delivery-settlement-batches": "node scripts/run-delivery-settlement-batches-migration.js",
    "db:migrate:payout-bank-profile": "node scripts/run-payout-bank-profile-migration.js",
    "db:migrate:delivery-recipient-cpf": "node scripts/run-delivery-recipient-cpf-migration.js",
    "db:migrate:delivery-settlement-split-batch-ids": "node scripts/run-delivery-settlement-split-batch-ids-migration.js",
    "db:migrate:partner-whatsapp": "node scripts/run-partner-whatsapp-migration.js",
    "db:migrate:loja-virtual": "node scripts/run-loja-virtual-migration.js",
    "db:migrate:store-slug": "node scripts/run-store-slug-migration.js",
    "db:migrate:store-order-payment": "node scripts/run-store-order-payment-migration.js",
    "db:migrate:store-appearance": "node scripts/run-store-appearance-migration.js",
    "db:migrate:store-coupons": "node scripts/run-store-coupons-migration.js",
    "db:migrate:store-reviews": "node scripts/run-store-reviews-migration.js"
