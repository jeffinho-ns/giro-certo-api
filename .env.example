# Database
DATABASE_URL=postgresql://ciro_certo_db_user:Ocmeex5f2qUViao967jipLoAzsEDVzM5@dpg-d5oq5dpr0fns73afoq50-a.oregon-postgres.render.com/ciro_certo_db

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Firebase Storage (mesmo projeto do vamos-comemorar, pasta giro-certo)
# Necessário para upload de imagens (perfil, posts, stories)
FIREBASE_STORAGE_BUCKET=agilizaiapp-img.firebasestorage.app
FIREBASE_ADMIN_PROJECT_ID=agilizaiapp-img
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Fallback: FIREBASE_ADMIN_CREDENTIALS_JSON_BASE64= (base64 do JSON do service account)

# --- Asaas (cobrança cliente final — Fase 1) ---
ASAAS_API_KEY=
# sandbox | production — define URL base se ASAAS_API_URL não estiver definida
ASAAS_ENV=sandbox
# Opcional — URL completa base v3 (ex.: https://api-sandbox.asaas.com/v3)
# ASAAS_API_URL=
ASAAS_USER_AGENT=GiroCerto/1.0
# Token do webhook (painel Asaas). Cabeçalho recebido: asaas-access-token
ASAAS_WEBHOOK_TOKEN=
# CPF de testes para cliente PF quando o pedido não traz documento (sandbox)
ASAAS_FALLBACK_PAYER_CPF=

# Split taxas fixas (alinhado ao doc de produto)
GIRO_PLATFORM_FEE_STORE_FIXED=2
GIRO_PLATFORM_FEE_RIDER_PER_ORDER=1

# Fase 2 (repasses): migrações (ordem)
# npm run db:migrate:delivery-settlement-ledger
# npm run db:migrate:delivery-settlement-batches
#
# Fase 3 — perfil de conta beneficiária (`payout_bank_account_json`; GET/PATCH payout-bank-profile)
# npm run db:migrate:payout-bank-profile
GIRO_SETTLEMENT_FEE_DAILY=2
GIRO_SETTLEMENT_FEE_WEEKLY=50
GIRO_SETTLEMENT_FEE_MONTHLY=40
GIRO_RIDER_DEFAULT_SETTLEMENT_FREQUENCY=weekly
# Piloto: taxa zero em todo lote ao compor (repassa bruto integral). Desligue em produção madura.
# GIRO_SETTLEMENT_WAIVE_BATCH_FEES=true

# Ative só quando quiser que POST .../execute-transfer chame o Asaas (repasse real).
# ASAAS_ENABLE_PAYOUTS=true

# --- WhatsApp Cloud API (pedido automático + link de pagamento) ---
# Meta Developers → WhatsApp → API Setup
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# URL pública da API (webhook no Meta)
API_PUBLIC_URL=https://giro-certo-api.onrender.com
# Piloto: uma loja se ainda não cadastrou phone_number_id no Partner
# WHATSAPP_DEFAULT_PARTNER_ID=

# Cron (Render etc.), header em todos: x-giro-cron-secret = GIRO_CRON_SECRET
#   POST /api/settlement/batches/compose-scheduled
#   POST /api/settlement/reconcile-scheduled  (payments + transfers no Asaas)
# GIRO_CRON_SECRET=
